@model UpdateSocialMediaDto
@{
    ViewData["Title"] = "UpdateSocialMedia";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}



<div class="page-content">
    <div class="container-fluid">


        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Sosyal Medya Bilgisi Güncelleme</h4>
                        <p class="card-subtitle mb-4">Sosyal Medya bilgilerini eksiksiz giriniz</p>

                        <form method="post">
                            <input type="hidden" asp-for="SocialMediaID" />
                            <div class="form-group">
                                <label for="exampleInputName">Başlık</label>
                                <input type="text" class="form-control" id="exampleInputName" asp-for="Name" placeholder="Başlık girin">
                            </div>

                            <div class="form-group">
                                <label for="exampleInputUrl">Url </label>
                                <input type="text" class="form-control" id="exampleInputUrl" asp-for="Url" placeholder="Url girin">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputIconUrl">İkon</label>
                                <input type="text" class="form-control" id="exampleInputIconUrl" asp-for="Icon" placeholder="Görsel Url girin">
                            </div>


                            <button type="submit" class="btn btn-primary waves-effect waves-light">Kaydet</button>
                        </form>

                    </div>
                </div>

            </div>

        </div>


    </div>

</div>

