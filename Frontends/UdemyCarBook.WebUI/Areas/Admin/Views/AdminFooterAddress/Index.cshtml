
@model List<ResultFooterAddressDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">


        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Footer alanı Adres  Alanı</h4>
                        <p class="card-subtitle mb-4">
                           iletişim ve footer alanında yer alan adres bilgilerine ait ekleme silme güncelleme işlemlerinizi yapabilrsiniz

                        </p>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>Adres</th>
                                        <th>Telefon</th>
                                        <th>E-mail</th>
                                        <th>Açıklama</th>

                                        <th>Sil</th>
                                        <th>Güncelle</th>
                                     

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Address</td>
                                            <td>@item.Phone</td>
                                            <td>@item.Email</td>
                                            <td>@item.Description</td>
                                       

                                            <td><a href="/Admin/AdminFooterAddress/RemoveFooterAddress/@item.FooterAdressID" class="btn btn-outline-danger">Sil</a></td>
                                            <td><a href="/Admin/AdminFooterAddress/UpdateFooterAddress/@item.FooterAdressID" class="btn btn-outline-success">Güncelle</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <td><a href="/Admin/AdminFooterAddress/CreateFooterAddress" class="btn btn-outline-primary">Yeni Hakkında Girişi</a></td>

                        </div>

                    </div>

                </div>


            </div>

        </div>


    </div>
</div>
