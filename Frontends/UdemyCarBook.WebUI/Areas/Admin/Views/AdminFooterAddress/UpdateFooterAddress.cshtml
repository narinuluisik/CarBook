@model UpdateFooterAddressDto
@{
    ViewData["Title"] = "UpdateFooterAddress";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}



<div class="page-content">
    <div class="container-fluid">


        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title"> Adress Bilgisi Güncelle</h4>
                        <p class="card-subtitle mb-4">Adress bilgilerini eksiksiz giriniz</p>

                        <form method="post">

                            <div class="form-group">
                                <input type="hidden" asp-for="FooterAdressID" />
                                <label for="exampleInputName">Adres</label>
                                <input type="text" class="form-control" id="exampleInputName" asp-for="Address" placeholder="Adress girin">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputPhone">Telefon</label>
                                <input type="text" class="form-control" id="exampleInputPhone" asp-for="Phone" placeholder="Telefon girin">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputmail">E-mail</label>
                                <input type="text" class="form-control" id="exampleInputEmail" asp-for="Email" placeholder="Mail Adresi girin">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputDescription">Açıklama </label>
                                <input type="text" class="form-control" id="exampleInputDescription" asp-for="Description" placeholder="Açıklama girin">
                            </div>



                            <button type="submit" class="btn btn-primary waves-effect waves-light">Kaydet</button>
                        </form>

                    </div>
                </div>

            </div>

        </div>


    </div>

</div>


