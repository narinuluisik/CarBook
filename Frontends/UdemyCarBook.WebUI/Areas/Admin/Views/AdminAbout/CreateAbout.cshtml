@using UdemyCarBook.Dto.AboutDtos


@model CreateAboutDto

@{
    ViewData["Title"] = "CreateAbout";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="page-content">
    <div class="container-fluid">


        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Yeni Hakkımızda Bilgisi Girişi</h4>
                        <p class="card-subtitle mb-4">Hakkımızda bilgilerini eksiksiz giriniz</p>

                        <form method="post">

                            <div class="form-group">
                                <label for="exampleInputName">Başlık</label>
                                <input type="text" class="form-control" id="exampleInputName" asp-for="title" placeholder="Başlık girin">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputDescription">Açıklama </label>
                                <input type="text" class="form-control" id="exampleInputDescription" asp-for="description" placeholder="Açıklama girin">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputVideoUrl">Görsel</label>
                                <input type="text" class="form-control" id="exampleInputVideoUrl" asp-for="imageUrl" placeholder="Görsel girin">
                            </div>
                         

                            <button type="submit" class="btn btn-primary waves-effect waves-light">Kaydet</button>
                        </form>

                    </div>
                </div>

            </div>

        </div>


    </div>

</div>


