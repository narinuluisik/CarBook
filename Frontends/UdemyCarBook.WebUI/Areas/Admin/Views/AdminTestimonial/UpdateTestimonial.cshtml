@model UpdateTestimonialDto
@{
    ViewData["Title"] = "UpdateTestimonial";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">


        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Referans Bilgisi Güncelleme</h4>
                        <p class="card-subtitle mb-4">Referans bilgilerini eksiksiz giriniz</p>

                        <form method="post">
                            <input type="hidden" asp-for="TestimonialID" />

                            <div class="form-group">
                                <label for="exampleInputName">Ad Soyad </label>
                                <input type="text" class="form-control" id="exampleInputName" asp-for="Name" placeholder="Ad Soyad girin">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputTitle">Başlık</label>
                                <input type="text" class="form-control" id="exampleInputTitle" asp-for="Title" placeholder="Başlık girin">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputComment">Yorum</label>
                                <input type="text" class="form-control" id="exampleInputComment" asp-for="Comment" placeholder="Yorum girin">
                            </div>

                            <div class="form-group">
                                <label for="exampleInputUrl">Resim Url </label>
                                <input type="text" class="form-control" id="exampleInputUrl" asp-for="ImageUrl" placeholder="Url girin">
                            </div>


                            <button type="submit" class="btn btn-primary waves-effect waves-light">Kaydet</button>
                        </form>

                    </div>
                </div>

            </div>

        </div>


    </div>

</div>

