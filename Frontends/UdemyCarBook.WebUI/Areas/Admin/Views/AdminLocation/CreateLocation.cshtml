@model CreateLocationDto
@{
    ViewData["Title"] = "CreateLocation";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}



<div class="page-content">
    <div class="container-fluid">


        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Yeni Lokasyon Bilgisi Girişi</h4>
                        <p class="card-subtitle mb-4">Lokasyon bilgilerini eksiksiz giriniz</p>

                        <form method="post">

                            <div class="form-group">
                                <label for="exampleInputName">Lokasyon</label>
                                <input type="text" class="form-control" id="exampleInputName" asp-for="Name" placeholder="Başlık girin">
                            </div>
                           


                            <button type="submit" class="btn btn-primary waves-effect waves-light">Kaydet</button>
                        </form>

                    </div>
                </div>

            </div>

        </div>


    </div>

</div>


