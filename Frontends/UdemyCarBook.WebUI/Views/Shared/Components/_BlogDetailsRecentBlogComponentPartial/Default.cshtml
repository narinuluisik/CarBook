@model List<ResultLast3BlogDto>
<div class="blog-sidebar-box">
    <h3>Son Bloglar</h3>
    @if (Model != null)
    {
        @foreach (var item in Model)
        {
            <div class="recent-blog-item">
                <a href="/Blog/BlogDetail/@item.BlogId" class="blog-img" style="background-image: url(@item.CoverImageUrl);"></a>
                <div class="text">
                    <h4><a href="/Blog/BlogDetail/@item.BlogId">@item.Title</a></h4>
                    <div class="meta">
                        <span><i class="far fa-calendar"></i> @item.CreatedDate</span>
                    </div>
                </div>
            </div>
        }
    }
</div>
