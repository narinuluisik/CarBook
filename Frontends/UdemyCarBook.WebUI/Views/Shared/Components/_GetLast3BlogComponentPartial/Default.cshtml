@model List<ResultLast3BlogDto>

<section class="homepage-blog">

    <div class="container">

        <div class="section-header ftco-animate">

            <span class="subheading">Blog</span>

            <h2>Son Yazılarımız</h2>

        </div>

        <div class="row">

            @foreach (var item in Model)

            {

                <div class="col-md-4 mb-4 ftco-animate">

                    <div class="homepage-blog-card">

                        <a href="/Blog/BlogDetail/@item.BlogId" class="blog-image d-block" style="background-image: url('@item.CoverImageUrl');"></a>

                        <div class="blog-body">

                            <div class="blog-meta">

                                <span><i class="far fa-calendar mr-1"></i> @item.CreatedDate</span>

                                <span><i class="far fa-user mr-1"></i> @item.AuthorName</span>

                            </div>

                            <h3><a href="/Blog/BlogDetail/@item.BlogId">@item.Title</a></h3>

                            <a href="/Blog/BlogDetail/@item.BlogId" class="btn-read">

                                Devamını Oku <i class="fas fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>

</section>

