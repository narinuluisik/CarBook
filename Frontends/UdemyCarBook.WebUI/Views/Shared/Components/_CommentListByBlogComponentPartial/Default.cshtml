@model List<ResultCommentDto>

@if (Model == null || !Model.Any())
{
    <p class="text-muted">Henüz yorum yapılmamış. İlk yorumu siz yazın.</p>
}
else
{
    <ul class="blog-comment-list">
        @foreach (var item in Model)
        {
            <li class="comment">
                <div class="vcard bio">
                    <img src="/carbook-master/images/person_1.jpg" alt="@item.Name">
                </div>
                <div class="comment-body">
                    <h3>@item.Name</h3>
                    <div class="meta">@item.CreatedDate.ToString("dd/MM/yyyy")</div>
                    <p>@item.Description</p>
                </div>
            </li>
        }
    </ul>
}
