@model GetBlogById
<div class="col-md-8 ftco-animate">
    <h2 class="mb-3">@Model.Title</h2>
    <p>@Model.Description</p>
    @await Component.InvokeAsync("_BlogDetailCloudTagBlogComponentPartial", new { id = Model.BlogID })
    @await Component.InvokeAsync("_BlodDetailAuthorAboutComponentPartial", new { id = Model.AuthorID })

    <div class="pt-5 mt-5">
        <h3 class="mb-5">@ViewBag.CommentCount Yorum</h3>
        @await Component.InvokeAsync("_CommentListByBlogComponentPartial", new { id = Model.BlogID })

        @await Html.PartialAsync("~/Views/Blog/AddComment.cshtml", new CreateCommentDto
        {
            BlogID = Model.BlogID
                })

    </div>

</div> 