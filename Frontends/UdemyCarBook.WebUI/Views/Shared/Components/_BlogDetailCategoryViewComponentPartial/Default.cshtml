@model List<ResultCategoryDto>
<div class="blog-sidebar-box">
    <div class="categories">
        <h3>Kategoriler</h3>
        <ul>
            @if (Model != null)
            {
                @foreach (var item in Model)
                {
                    <li><a href="/Blog/Index/">@item.Name</a></li>
                }
            }
        </ul>
    </div>
</div>
