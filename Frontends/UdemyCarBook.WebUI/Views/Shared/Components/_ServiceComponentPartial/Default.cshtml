@model List<ResultServiceDto>
@{
    int count = 0;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

    /* --- INTERAKTİF & ANIMASYONLU HİZMETLER ALANI --- */
    .homepage-services {
        padding: 8rem 0;
        background: #f4f7fc;
        font-family: 'Poppins', sans-serif;
        perspective: 1000px;
    }

    .section-header {
        text-align: center;
        margin-bottom: 60px;
    }

        .section-header .subheading {
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 700;
            color: #0056b3;
            margin-bottom: 12px;
            display: block;
        }

        .section-header h2 {
            font-size: 38px;
            font-weight: 800;
            color: #0a254a;
            margin-bottom: 15px;
            letter-spacing: -0.5px;
        }

        .section-header p {
            color: #5a6578;
            font-size: 16px;
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.7;
        }

    /* --- GİRİŞ ANİMASYONU İÇİN İLK DURUM (Görünmez & Aşağıda) --- */
    .animate-card-trigger {
        opacity: 0;
        transform: translateY(50px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        height: 100%;
    }

        /* Ekrana girdiğinde tetiklenecek sınıf */
        .animate-card-trigger.is-visible {
            opacity: 1;
            transform: translateY(0);
        }

    /* --- INTERAKTİF KART YAPISI --- */
    .interactive-card-wrapper {
        perspective: 1000px;
        height: 100%;
    }

    .homepage-service-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 50px 35px 40px 35px;
        text-align: left;
        border: 1px solid rgba(0, 86, 179, 0.05);
        box-shadow: 0 15px 40px rgba(10, 37, 74, 0.03);
        height: 100%;
        position: relative;
        overflow: hidden;
        z-index: 1;
        transform-style: preserve-3d;
        transform: rotateX(0deg) rotateY(0deg);
        transition: transform 0.1s ease, box-shadow 0.3s ease;
    }

        /* Fareyi Takip Eden Dinamik Parlama Efekti */
        .homepage-service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            opacity: 0;
            background: radial-gradient(800px circle at var(--x, 0px) var(--y, 0px), var(--grad-color-1, #0a254a) 0%, var(--grad-color-2, #0056b3) 100%);
            transition: opacity 0.5s ease;
        }

        /* Derinlik Hissiyatı Elementleri */
        .icon-wrap, .homepage-service-card h3, .homepage-service-card p, .card-number {
            transform: translateZ(30px);
            transition: transform 0.3s ease;
        }

    .card-number {
        position: absolute;
        top: 20px;
        right: 30px;
        font-size: 48px;
        font-weight: 800;
        color: rgba(0, 86, 179, 0.04);
        line-height: 1;
    }

    .icon-wrap {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 30px;
        font-size: 26px;
    }

    .homepage-service-card h3 {
        font-size: 20px;
        font-weight: 700;
        color: #0a254a;
        margin-bottom: 14px;
        letter-spacing: -0.3px;
    }

    .homepage-service-card p {
        font-size: 14px;
        color: #5a6578;
        line-height: 1.7;
        margin-bottom: 0;
    }

    /* --- HOVER EFEKTLERİ --- */
    .homepage-service-card:hover {
        box-shadow: 0 30px 60px rgba(10, 37, 74, 0.18);
    }

        .homepage-service-card:hover::before {
            opacity: 1;
        }

        .homepage-service-card:hover h3,
        .homepage-service-card:hover p {
            color: #ffffff;
        }

        .homepage-service-card:hover .card-number {
            color: rgba(255, 255, 255, 0.12);
        }

        .homepage-service-card:hover .icon-wrap {
            background: #ffffff !important;
            transform: translateZ(40px) scale(1.05);
        }

    /* --- TEMA RENKLERİ --- */
    .card-theme-0 {
        --grad-color-1: #0a254a;
        --grad-color-2: #0056b3;
    }

        .card-theme-0 .icon-wrap {
            background: rgba(10, 37, 74, 0.06);
            color: #0a254a;
        }

        .card-theme-0:hover .icon-wrap {
            color: #0056b3;
        }

    .card-theme-1 {
        --grad-color-1: #0056b3;
        --grad-color-2: #00b4db;
    }

        .card-theme-1 .icon-wrap {
            background: rgba(0, 86, 179, 0.06);
            color: #0056b3;
        }

        .card-theme-1:hover .icon-wrap {
            color: #00b4db;
        }

    .card-theme-2 {
        --grad-color-1: #4e54c8;
        --grad-color-2: #8f94fb;
    }

        .card-theme-2 .icon-wrap {
            background: rgba(78, 84, 200, 0.06);
            color: #4e54c8;
        }

        .card-theme-2:hover .icon-wrap {
            color: #4e54c8;
        }

    .card-theme-3 {
        --grad-color-1: #0f2027;
        --grad-color-2: #203a43;
    }

        .card-theme-3 .icon-wrap {
            background: rgba(32, 58, 67, 0.06);
            color: #203a43;
        }

        .card-theme-3:hover .icon-wrap {
            color: #0f2027;
        }
</style>

<section class="homepage-services">
    <div class="container">

        <div class="section-header">
            <span class="subheading">Ayrıcalıklarımız</span>
            <h2>Sizin İçin Sunduğumuz Hizmetler</h2>
            <p>
                Güvenli, konforlu ve profesyonel araç kiralama deneyimi için
                ihtiyaç duyduğunuz tüm hizmetleri tek çatı altında sunuyoruz.
            </p>
        </div>

        <div class="row">
            @foreach (var item in Model ?? new List<ResultServiceDto>())
            {
                var themeClass = "card-theme-" + (count % 4);
                count++;

                <div class="col-lg-3 col-md-6 mb-4">
                    <!-- Giriş Animasyonunu Yöneten Dış Kapsayıcı -->
                    <div class="animate-card-trigger">
                        <div class="interactive-card-wrapper">
                            <div class="homepage-service-card @themeClass">
                                <div class="card-number">@count.ToString("D2")</div>
                                <div class="icon-wrap">
                                    <span class="@item.IconUrl"></span>
                                </div>
                                <h3>@item.Title</h3>
                                <p>@item.Description</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

<!-- HAREKET VE GİRİŞ ANİMASYONU MOTORU -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // --- 1. KAYDIRMA (SCROLL) GİRİŞ ANİMASYONU ---
        const animatedCards = document.querySelectorAll('.animate-card-trigger');

        const observerOptions = {
            root: null,
            threshold: 0.15 // Kartın %15'i ekrana girince animasyon başlar
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    // Kartlar yan yana sırayla (gecikmeli) gelsin diye milisaniye ekliyoruz
                    setTimeout(() => {
                        entry.target.classList.add('is-visible');
                    }, index * 120); // 120ms aralıklarla sırayla patlarlar
                    observer.unobserve(entry.target); // Bir kez çalışması yeterli
                }
            });
        }, observerOptions);

        animatedCards.forEach(card => observer.observe(card));


        // --- 2. 3D EĞİM VE PARLAMA MOTORU ---
        const cards = document.querySelectorAll('.homepage-service-card');

        cards.forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();

                // Fare koordinatları (Parlama için)
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--x', `${x}px`);
                card.style.setProperty('--y', `${y}px`);

                // 3D Eğim (Tilt) hesabı
                const cardWidth = rect.width;
                const cardHeight = rect.height;
                const centerX = rect.left + cardWidth / 2;
                const centerY = rect.top + cardHeight / 2;
                const mouseX = e.clientX - centerX;
                const mouseY = e.clientY - centerY;

                const rotateX = (-mouseY / cardHeight) * 15;
                const rotateY = (mouseX / cardWidth) * 15;

                card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
            });

            card.addEventListener('mouseleave', () => {
                card.style.transform = 'rotateX(0deg) rotateY(0deg)';
                card.style.transition = 'transform 0.5s ease, box-shadow 0.3s ease';
            });

            card.addEventListener('mouseenter', () => {
                card.style.transition = 'transform 0.1s ease, box-shadow 0.3s ease';
            });
        });
    });
</script>