@model List<UdemyCarBook.Dto.TagCloudDtos.GetByIdTagCloudDto>

<div class="blog-sidebar-box">
    <h3>Etiket Bulutu</h3>
    <div class="tagcloud">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <a href="/Blog/Index/" class="tag-cloud-link">@item.Title</a>
            }
        }
        else
        {
            <p class="mb-0 text-muted">Bu blog için etiket bulunamadı.</p>
        }
    </div>
</div>
