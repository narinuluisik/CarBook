@model List<UdemyCarBook.Dto.AboutDtos.ResultAboutDto>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

    /* --- GEOMETRİK HAKKIMIZDA BÖLÜMÜ --- */
    .homepage-about {
        padding: 8rem 0;
        background: #fdfdfd;
        font-family: 'Poppins', sans-serif;
        position: relative;
        overflow: hidden;
    }

        /* Arka Plandaki Büyük Soyut Geometri */
        .homepage-about::after {
            content: '';
            position: absolute;
            bottom: -10%;
            right: -5%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(0, 86, 179, 0.03) 0%, transparent 70%);
            border-radius: 50%;
            z-index: 1;
        }

    /* --- SOL TARAF: GEOMETRİK GÖRSEL KATMANLARI --- */
    .about-image-wrapper {
        position: relative;
        padding: 30px;
        z-index: 2;
    }

        /* Arkadaki Keskin Mavi Geometrik Kutu */
        .about-image-wrapper::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 90%;
            height: 90%;
            background: linear-gradient(135deg, #0a254a 0%, #0056b3 100%);
            border-radius: 24px;
            transform: rotate(-3deg);
            z-index: 1;
            box-shadow: 0 15px 35px rgba(10, 37, 74, 0.15);
        }

        /* Arkadaki İkinci Açık Mavi Çizgisel Geometri */
        .about-image-wrapper::after {
            content: '';
            position: absolute;
            bottom: 10px;
            right: 10px;
            width: 50%;
            height: 50%;
            border: 4px solid rgba(0, 86, 179, 0.2);
            border-radius: 24px;
            transform: rotate(6deg);
            z-index: 1;
            pointer-events: none;
        }

    .about-image {
        height: 460px;
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        border-radius: 24px;
        position: relative;
        z-index: 2;
        transform: rotate(0deg);
        transition: transform 0.4s ease;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.15);
    }

    .about-image-wrapper:hover .about-image {
        transform: scale(1.02) rotate(1deg);
    }

    /* --- SAĞ TARAF: GEOMETRİK YAZI PANELİ --- */
    .about-content-card {
        position: relative;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(240, 244, 250, 0.98) 100%);
        border: 1px solid rgba(0, 86, 179, 0.08);
        border-radius: 32px;
        padding: 50px;
        z-index: 2;
        box-shadow: 0 25px 55px rgba(10, 37, 74, 0.05);
    }

        /* Kutu Köşesindeki Geometrik Vurgu Çizgisi */
        .about-content-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 40px;
            width: 60px;
            height: 5px;
            background: #0056b3;
            border-radius: 0 0 10px 10px;
        }

        .about-content-card .subheading {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-weight: 800;
            color: #0056b3;
            margin-bottom: 15px;
            display: block;
        }

        .about-content-card h2 {
            font-size: 38px;
            font-weight: 800;
            color: #0a254a;
            line-height: 1.25;
            margin-bottom: 25px;
            letter-spacing: -0.5px;
        }

        .about-content-card p {
            color: #4a5568;
            font-size: 15.5px;
            line-height: 1.75;
            margin-bottom: 35px;
            font-weight: 400;
        }

    /* Modern Dinamik Buton */
    .btn-about {
        height: 52px;
        background: #0a254a;
        color: #ffffff !important;
        padding: 0 35px;
        border-radius: 14px;
        font-size: 15px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 10px 20px rgba(10, 37, 74, 0.15);
    }

        .btn-about:hover {
            background: #0056b3;
            transform: translateY(-3px) translateX(2px);
            box-shadow: 0 15px 30px rgba(0, 86, 179, 0.25);
        }

    /* Mobil Ekran Ayarları */
    @@media (max-width: 991px) {
        .about-content-card {
            padding: 30px;
            margin-top: 50px;
            border-radius: 24px;
        }

        .about-image {
            height: 350px;
        }
    }
</style>

@foreach (var item in Model ?? new List<UdemyCarBook.Dto.AboutDtos.ResultAboutDto>())
{
    <section class="homepage-about">
        <div class="container">
            <div class="row align-items-center">

                <!-- Sol Taraf: Geometrik Katmanlı Görsel -->
                <div class="col-lg-6 ftco-animate">
                    <div class="about-image-wrapper">
                        <div class="about-image" style="background-image: url('@item.imageUrl');"></div>
                    </div>
                </div>

                <!-- Sağ Taraf: Geometrik Arka Planlı Yazı Kartı -->
                <div class="col-lg-6 ftco-animate">
                    <div class="about-content-card">
                        <span class="subheading">Vizyonumuz & Biz</span>
                        <h2>@item.title</h2>
                        <p>@item.description</p>
                        <a href="/RentACarList/Index/" class="btn-about">
                            <i class="fas fa-car"></i> Hemen Araç Kirala <i class="fas fa-arrow-right" style="font-size: 12px;"></i>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>
}