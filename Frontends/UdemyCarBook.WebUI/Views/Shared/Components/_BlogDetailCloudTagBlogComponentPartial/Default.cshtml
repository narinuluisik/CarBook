@model List<UdemyCarBook.Dto.TagCloudDtos.GetByIdTagCloudDto>
@if (Model != null && Model.Any())
{
    <div class="article-tags">
        <div class="tagcloud">
            @foreach (var item in Model)
            {
                <a href="/Blog/Index/" class="tag-cloud-link">@item.Title</a>
            }
        </div>
    </div>
}
