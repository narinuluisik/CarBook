<section class="ftco-counter ftco-section img bg-light py-5" id="section-counter">
    <div class="overlay"></div>
    <div class="container">
        <div class="row justify-content-center text-center">

            <!-- Toplam Araç Sayısı -->
            <div class="col-md-6 col-lg-3 mb-4 mb-lg-0 counter-wrap ftco-animate">
                <div class="block-18 p-4 shadow-sm rounded bg-white h-100 d-flex flex-column align-items-center justify-content-center">
                    <div class="icon mb-3 text-primary" style="font-size: 2.5rem;">
                        <i class="fas fa-car"></i>
                    </div>
                    <div class="text d-flex flex-column align-items-center">
                        <strong class="number display-4 font-weight-bold text-dark mb-2" data-number="@ViewBag.carCount">0</strong>
                        <span class="text-muted font-weight-medium text-uppercase small tracking-wider">Toplam Araç Sayısı</span>
                    </div>
                </div>
            </div>

            <!-- Lokasyon Sayısı -->
            <div class="col-md-6 col-lg-3 mb-4 mb-lg-0 counter-wrap ftco-animate">
                <div class="block-18 p-4 shadow-sm rounded bg-white h-100 d-flex flex-column align-items-center justify-content-center">
                    <div class="icon mb-3 text-success" style="font-size: 2.5rem;">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="text d-flex flex-column align-items-center">
                        <strong class="number display-4 font-weight-bold text-dark mb-2" data-number="@ViewBag.locationCount">0</strong>
                        <span class="text-muted font-weight-medium text-uppercase small tracking-wider">Lokasyon Sayısı</span>
                    </div>
                </div>
            </div>

            <!-- Marka Sayısı -->
            <div class="col-md-6 col-lg-3 mb-4 mb-md-0 counter-wrap ftco-animate">
                <div class="block-18 p-4 shadow-sm rounded bg-white h-100 d-flex flex-column align-items-center justify-content-center">
                    <div class="icon mb-3 text-info" style="font-size: 2.5rem;">
                        <i class="fas fa-tags"></i>
                    </div>
                    <div class="text d-flex flex-column align-items-center">
                        <strong class="number display-4 font-weight-bold text-dark mb-2" data-number="@ViewBag.brandCount">0</strong>
                        <span class="text-muted font-weight-medium text-uppercase small tracking-wider">Marka Sayısı</span>
                    </div>
                </div>
            </div>

            <!-- Elektrikli Araç Sayısı -->
            <div class="col-md-6 col-lg-3 counter-wrap ftco-animate">
                <div class="block-18 p-4 shadow-sm rounded bg-white h-100 d-flex flex-column align-items-center justify-content-center">
                    <div class="icon mb-3 text-warning" style="font-size: 2.5rem;">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <div class="text d-flex flex-column align-items-center">
                        <strong class="number display-4 font-weight-bold text-dark mb-2" data-number="@ViewBag.carCountByFuelElectric">0</strong>
                        <span class="text-muted font-weight-medium text-uppercase small tracking-wider">Elektrikli Araç</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>