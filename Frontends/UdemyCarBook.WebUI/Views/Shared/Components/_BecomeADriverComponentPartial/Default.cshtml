<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');
    /* --- TEMAYA UYUMLU CTA ALANI --- */
    .homepage-cta {
        padding: 6rem 0;
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        background-attachment: scroll;
        position: relative;
        font-family: 'Poppins', sans-serif;
        overflow: hidden;
        min-height: 450px;
        display: flex;
        align-items: center;
        background-color: #0a1830;
    }

    .homepage-cta::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(10, 37, 74, 0.95) 0%, rgba(5, 19, 41, 0.9) 100%);
        z-index: 1;
    }

    .homepage-cta::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(0, 168, 204, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 168, 204, 0.03) 1px, transparent 1px);
        background-size: 35px 35px;
        z-index: 2;
        pointer-events: none;
    }

    .homepage-cta .container {
        position: relative;
        z-index: 5;
    }

    /* --- HARİTA VE ÇEVRESEL ÖGELER --- */
    .map-simulation-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 3;
        pointer-events: none;
    }

    .road-bed {
        stroke: #0d1f38;
        stroke-width: 15;
        fill: none;
        stroke-linecap: round;
        opacity: 0.55;
    }

    .road-surface {
        stroke: rgba(255, 255, 255, 0.05);
        stroke-width: 12;
        fill: none;
        stroke-linecap: round;
    }

    .road-lane {
        stroke: rgba(255, 255, 255, 0.35);
        stroke-width: 1.6;
        stroke-dasharray: 10 10;
        fill: none;
        stroke-linecap: round;
        animation: laneFlow 1.2s linear infinite;
    }

    .curved-track-glow {
        stroke: url(#siteThemeGrad);
        stroke-width: 3;
        fill: none;
        stroke-linecap: round;
        filter: drop-shadow(0 0 6px rgba(0, 168, 204, 0.7));
        stroke-dasharray: 6 500;
        animation: drawRoute 3.5s ease-out forwards;
    }

    @@keyframes drawRoute {
        from

    {
        stroke-dashoffset: 0;
        stroke-dasharray: 0 2000;
    }

    to {
        stroke-dashoffset: 0;
        stroke-dasharray: 2000 0;
    }

    }

    @@keyframes laneFlow {
        to

    {
        stroke-dashoffset: -40;
    }

    }

    /* Başlangıç / Varış İşaretçileri */
    .route-pin {
        position: absolute;
        transform: translate(-50%, -70%) scale(0.8);
        display: flex;
        flex-direction: column;
        align-items: center;
        opacity: 0;
        transition: opacity 0.6s ease 1s, transform 0.6s cubic-bezier(0.34,1.56,0.64,1) 1s;
    }

    .homepage-cta.is-triggered .route-pin {
        opacity: 1;
        transform: translate(-50%, -70%) scale(1);
    }

    .route-pin svg {
        filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5));
    }

    .route-pin .pin-label {
        margin-top: 4px;
        font-size: 10px;
        font-weight: 600;
        color: #cfe9f2;
        background: rgba(6, 19, 41, 0.85);
        border: 1px solid rgba(0, 168, 204, 0.3);
        padding: 2px 8px;
        border-radius: 20px;
        white-space: nowrap;
        letter-spacing: 0.5px;
    }

    .map-city-node {
        position: absolute;
        width: 9px;
        height: 9px;
        background: #00a8cc;
        border-radius: 50%;
        box-shadow: 0 0 15px #00a8cc;
    }

        .map-city-node::after {
            content: '';
            position: absolute;
            inset: -8px;
            border: 1.5px solid rgba(0, 168, 204, 0.4);
            border-radius: 50%;
            animation: pulseRing 2.5s infinite ease-out;
        }

    .node-1 {
        left: 34%;
        top: 30%;
    }

    /* --- HUD PANELİ --- */
    .hud-panel {
        position: absolute;
        top: 8%;
        left: 4%;
        display: flex;
        gap: 10px;
        opacity: 0;
        transform: translateY(-10px);
        transition: all 0.7s cubic-bezier(0.16,1,0.3,1) 0.4s;
    }

    .homepage-cta.is-triggered .hud-panel {
        opacity: 1;
        transform: translateY(0);
    }

    .hud-chip {
        background: rgba(6, 19, 41, 0.65);
        border: 1px solid rgba(0, 168, 204, 0.25);
        backdrop-filter: blur(6px);
        border-radius: 10px;
        padding: 8px 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .hud-chip i {
            color: #00a8cc;
            font-size: 13px;
        }

        .hud-chip span {
            color: #e8f4f8;
            font-size: 12px;
            font-weight: 600;
        }

        .hud-chip small {
            display: block;
            color: rgba(232,244,248,0.5);
            font-size: 8px;
            text-transform: uppercase;
        }

    /* --- ARAÇ VE EFEKTLER --- */
    #movingCar {
        position: absolute;
        z-index: 4;
        transform: translate(-50%, -50%) scale(1.15);
        will-change: left, top, transform;
    }

    .car-shadow {
        position: absolute;
        z-index: 3;
        width: 46px;
        height: 12px;
        background: radial-gradient(ellipse at center, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 72%);
        transform: translate(-50%, -50%);
        will-change: left, top;
        pointer-events: none;
    }

    .exhaust-puff {
        position: absolute;
        z-index: 3;
        border-radius: 50%;
        background: rgba(180, 200, 215, 0.35);
        pointer-events: none;
    }

    /* --- CTA KART ÇERÇEVESİ --- */
    .cta-card-wrapper {
        position: relative;
        border-radius: 24px;
        padding: 2px;
        overflow: hidden;
        background: rgba(0, 168, 204, 0.15);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
        opacity: 0;
        transform: translateX(40px);
        transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .homepage-cta.is-triggered .cta-card-wrapper {
        opacity: 1;
        transform: translateX(0);
    }

    .cta-card-wrapper::before {
        content: '';
        position: absolute;
        width: 160%;
        height: 160%;
        top: -30%;
        left: -30%;
        background: conic-gradient(from 0deg, transparent 30%, #00a8cc, transparent 60%, #0056b3, transparent 90%);
        animation: rotateBorder 8s linear infinite;
        z-index: 1;
    }

    .cta-dynamic-card {
        background: #061329;
        border-radius: 22px;
        padding: 36px 42px;
        position: relative;
        z-index: 2;
    }

        .cta-dynamic-card h2 {
            color: #ffffff;
            font-size: 26px;
            font-weight: 700;
            line-height: 1.35;
            margin-bottom: 24px;
        }

    .btn-cta-interactive {
        height: 52px;
        background: #0056b3;
        color: #ffffff !important;
        padding: 0 35px;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none !important;
        transition: all 0.3s ease;
        box-shadow: 0 8px 20px rgba(0, 86, 179, 0.25);
    }

        .btn-cta-interactive:hover {
            background: #004085;
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(0, 86, 179, 0.4);
        }

    @@keyframes rotateBorder {
        100%

    {
        transform: rotate(360deg);
    }

    }
    @@keyframes pulseRing {
        0%

    {
        transform: scale(0.6);
        opacity: 1;
    }

    100% {
        transform: scale(1.6);
        opacity: 0;
    }

    }

    /* --- RESPONSIVE OPTİMİZASYONU --- */
    @@media (max-width: 991px) {
        .homepage-cta

    {
        padding: 4rem 0;
        min-height: auto;
    }

    .cta-dynamic-card {
        padding: 32px 24px;
        text-align: center;
    }

        .cta-dynamic-card h2 {
            font-size: 22px;
        }

    .map-simulation-container, .map-city-node, .hud-panel {
        display: none !important;
    }

    }
</style>

<section class="homepage-cta" id="themedSimulationSection" style="background-image: url('/carbook-master/images/bg_3.jpg');">
    <!-- Entegre Simülasyon Dünyası -->
    <div class="map-simulation-container">
        <div class="map-city-node node-1"></div>

        <!-- HUD paneli -->
        <div class="hud-panel">
            <div class="hud-chip">
                <i class="fas fa-route"></i>
                <span>18.4 km<small>Mesafe</small></span>
            </div>
            <div class="hud-chip">
                <i class="fas fa-clock"></i>
                <span>22 dk<small>Süre</small></span>
            </div>
        </div>

        <svg viewBox="0 0 1400 600" preserveAspectRatio="none" style="position:absolute;inset:0;width:100%;height:100%;">
            <defs>
                <linearGradient id="siteThemeGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#0056b3" />
                    <stop offset="100%" stop-color="#00a8cc" />
                </linearGradient>
            </defs>
            <path id="themedTrack" d="M 40,380 C 220,480 160,220 380,260 C 520,290 560,120 700,90 C 850,60 1000,70 1350,60" class="road-bed" />
            <path d="M 40,380 C 220,480 160,220 380,260 C 520,290 560,120 700,90 C 850,60 1000,70 1350,60" class="road-surface" />
            <path d="M 40,380 C 220,480 160,220 380,260 C 520,290 560,120 700,90 C 850,60 1000,70 1350,60" class="road-lane" />
            <path d="M 40,380 C 220,480 160,220 380,260 C 520,290 560,120 700,90 C 850,60 1000,70 1350,60" class="curved-track-glow" />
        </svg>

        <!-- Başlangıç / Varış Pinleri -->
        <div class="route-pin pin-start" style="left:2.8%; top:63.3%;">
            <svg width="22" height="28" viewBox="0 0 22 28" fill="none">
                <path d="M11 0C4.9 0 0 4.9 0 11c0 8.25 11 17 11 17s11-8.75 11-17C22 4.9 17.1 0 11 0z" fill="#00a8cc" />
                <circle cx="11" cy="11" r="4.5" fill="#061329" />
            </svg>
            <span class="pin-label">BAŞLANGIÇ</span>
        </div>
        <div class="route-pin pin-end" style="left:96.4%; top:10%;">
            <svg width="22" height="28" viewBox="0 0 22 28" fill="none">
                <path d="M11 0C4.9 0 0 4.9 0 11c0 8.25 11 17 11 17s11-8.75 11-17C22 4.9 17.1 0 11 0z" fill="#0056b3" />
                <circle cx="11" cy="11" r="4.5" fill="#061329" />
            </svg>
            <span class="pin-label">VARIŞ</span>
        </div>

        <div class="car-shadow" id="carShadow"></div>

        <div id="movingCar">
            <svg width="52" height="26" viewBox="0 0 52 26" fill="none">
                <defs>
                    <linearGradient id="carBodyGrad" x1="0" y1="0" x2="0" y2="26" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="#1a3a5c" />
                        <stop offset="45%" stop-color="#0d2440" />
                        <stop offset="100%" stop-color="#061329" />
                    </linearGradient>
                    <linearGradient id="carGlassGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#8fdcf0" />
                        <stop offset="100%" stop-color="#1c5f78" />
                    </linearGradient>
                    <radialGradient id="headlightGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
                        <stop offset="100%" stop-color="#00a8cc" stop-opacity="0" />
                    </radialGradient>
                </defs>
                <ellipse cx="50" cy="16" rx="16" ry="6" fill="url(#headlightGlow)" opacity="0.55" />
                <path d="M2 17.5C2 17.5 3 20 6 20H46C49 20 50 17.5 50 17.5L47 12C45.5 10 41 8.5 36 8H16C11 8.5 6.5 10 5 12L2 17.5Z" fill="url(#carBodyGrad)" stroke="#00a8cc" stroke-width="1.1" />
                <path d="M13 8.2C14.5 5 18 3.2 22 3.1H30C34 3.2 37 5.2 38.3 8.2H13Z" fill="url(#carBodyGrad)" stroke="#00a8cc" stroke-width="1" />
                <path d="M15.3 7.6C16.6 5.4 18.9 4.1 21.5 4H23.5V7.6H15.3Z" fill="url(#carGlassGrad)" />
                <path d="M25 4H28.8C31.3 4.1 33.5 5.4 34.8 7.6H25V4Z" fill="url(#carGlassGrad)" />
                <rect x="46.3" y="13.5" width="3" height="3" rx="1" fill="#fff7d6" />
                <rect x="2.5" y="13.8" width="2.4" height="2.4" rx="0.8" fill="#ff5b5b" />
                <path d="M4 14.5H48" stroke="#00a8cc" stroke-width="0.6" opacity="0.5" />
                <circle cx="13.5" cy="20" r="4.3" fill="#08131f" stroke="#00a8cc" stroke-width="1" />
                <circle cx="13.5" cy="20" r="1.8" fill="#0056b3" />
                <circle cx="38.5" cy="20" r="4.3" fill="#08131f" stroke="#00a8cc" stroke-width="1" />
                <circle cx="38.5" cy="20" r="1.8" fill="#0056b3" />
            </svg>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center justify-content-lg-end">
            <div class="col-md-10 col-lg-6">
                <div class="cta-card-wrapper">
                    <div class="cta-dynamic-card">
                        <h2>Aceleniz mi var? Profesyonel şoför hizmetimizle yolculuğunuzu konforlu hale getirin.</h2>
                        <a href="/Contact/Index/" class="btn-cta-interactive">
                            <i class="fas fa-phone-alt"></i> Bizimle İletişime Geçin
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const section = document.getElementById('themedSimulationSection');
        const track = document.getElementById('themedTrack');
        const car = document.getElementById('movingCar');
        const shadow = document.getElementById('carShadow');
        const mapContainer = document.querySelector('.map-simulation-container');

        if (section && track && car) {
            const trackLength = track.getTotalLength();
            let currentProgress = 0;
            let direction = 1;
            const speed = 0.0012;
            let isMoving = false;
            let puffTimer = 0;

            let containerRect = mapContainer.getBoundingClientRect();
            let scaleX = containerRect.width / 1400;
            let scaleY = containerRect.height / 600;

            // Pencere boyutu değiştiğinde oranları güncelle
            window.addEventListener('resize', () => {
                containerRect = mapContainer.getBoundingClientRect();
                scaleX = containerRect.width / 1400;
                scaleY = containerRect.height / 600;
            });

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-triggered');
                        if (!isMoving) {
                            isMoving = true;
                            requestAnimationFrame(playSimulationLoop);
                        }
                    }
                });
            }, { threshold: 0.2 });

            observer.observe(section);

            function spawnExhaustPuff(x, y) {
                if(window.innerWidth <= 991) return; // Mobilde duman üretme
                const puff = document.createElement('div');
                puff.className = 'exhaust-puff';
                const size = 4 + Math.random() * 4;
                puff.style.width = size + 'px';
                puff.style.height = size + 'px';
                puff.style.left = (x * scaleX) + 'px';
                puff.style.top = (y * scaleY) + 'px';
                puff.style.opacity = '0.5';
                puff.style.transform = 'translate(-50%, -50%)';
                puff.style.transition = 'all 0.7s ease-out';
                mapContainer.appendChild(puff);

                requestAnimationFrame(() => {
                    puff.style.opacity = '0';
                    puff.style.transform = `translate(-50%, -50%) scale(2.4) translateY(6px)`;
                });

                setTimeout(() => puff.remove(), 750);
            }

            function playSimulationLoop() {
                if(window.innerWidth <= 991) {
                    isMoving = false; // Mobilde animasyonu durdur, işlemci yormasın
                    return;
                }

                currentProgress += speed * direction;

                // CRITICAL FIX: Sınırı 0.64 yerine 0.96 yaparak arabanın TAM varış pini yanına ulaşmasını sağladık.
                if (currentProgress >= 0.96) {
                    direction = -1;
                } else if (currentProgress <= 0.03) {
                    direction = 1;
                }

                const point = track.getPointAtLength(currentProgress * trackLength);
                const nextPoint = track.getPointAtLength(Math.min(Math.max(currentProgress + 0.002 * direction, 0), 1) * trackLength);

                let angle = Math.atan2(nextPoint.y - point.y, nextPoint.x - point.x) * 180 / Math.PI;
                if (direction === -1) angle += 180;

                const left = point.x * scaleX;
                const top = point.y * scaleY;

                car.style.left = `${left}px`;
                car.style.top = `${top}px`;
                car.style.transform = `translate(-50%, -50%) rotate(${angle}deg) scale(1.15)`;

                if (shadow) {
                    shadow.style.left = `${left}px`;
                    shadow.style.top = `${top + 7}px`;
                    shadow.style.transform = `translate(-50%, -50%) rotate(${angle}deg) scaleX(${0.9 + Math.abs(Math.cos(angle * Math.PI / 180)) * 0.3})`;
                }

                puffTimer++;
                if (puffTimer % 6 === 0) {
                    const offset = 18;
                    const px = point.x - Math.cos(angle * Math.PI / 180) * (direction === 1 ? offset : -offset);
                    const py = point.y - Math.sin(angle * Math.PI / 180) * (direction === 1 ? offset : -offset);
                    spawnExhaustPuff(px, py);
                }

                requestAnimationFrame(playSimulationLoop);
            }
        }
    });
</script>