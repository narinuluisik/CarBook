@model CreateCommentDto
<div class="blog-comment-form">
    <h3>Bir Yorum Yapın</h3>
    <form method="post" asp-action="AddComment" asp-controller="Blog" asp-route-id="@Model.BlogID">
        <div class="form-group">
            <label for="name">Adınız Soyadınız</label>
            <input type="text" name="Name" class="form-control" id="name">
        </div>
        <input type="hidden" name="BlogID" value="@Model.BlogID" />
        <div class="form-group">
            <label for="email">E-posta Adresiniz</label>
            <input type="email" name="Email" class="form-control" id="email">
        </div>
        <div class="form-group">
            <label for="message">Yorumunuz</label>
            <textarea name="Description" id="message" cols="30" rows="6" class="form-control"></textarea>
        </div>
        <div class="form-group mb-0">
            <input type="submit" value="Yorum Yap" class="btn btn-submit">
        </div>
    </form>
</div>
