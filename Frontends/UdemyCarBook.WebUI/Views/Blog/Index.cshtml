@model List<ResultAllBlogDto>
@{
    ViewData["Title"] = "Blog";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="intro-strip">
    <div class="container intro-strip-inner">
        <div>
            <h3>Güncel içerikler ve ipuçları</h3>
            <p>Araç kiralama, seyahat ve otomotiv dünyasından en son yazılarımızı keşfedin.</p>
        </div>
        <div class="intro-strip-stats">
            <div class="stat-item"><strong>500+</strong><span>Araç Filosu</span></div>
            <div class="stat-divider"></div>
            <div class="stat-item"><strong>50+</strong><span>Lokasyon</span></div>
            <div class="stat-divider"></div>
            <div class="stat-item"><strong>7/24</strong><span>Destek</span></div>
        </div>
    </div>
</section>

<section class="blog-list-section">
    <div class="container">
        <div class="section-header-modern">
            <h2>Blog Yazılarımız</h2>
            <p>Yazarlarımızın hazırladığı güncel makaleler, rehberler ve sektör haberleri.</p>
            <div class="accent-line"></div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="blog-list-grid">
                @foreach (var blog in Model)
                {
                    <article class="blog-list-card">
                        <a href="/Blog/BlogDetail/@blog.blogID" class="blog-image" style="background-image: url('@blog.CoverImageUrl');"></a>
                        <div class="blog-body">
                            <div class="blog-meta">
                                <span><i class="far fa-calendar"></i> @blog.CreatedDate.ToShortDateString()</span>
                                <span><i class="far fa-user"></i> @blog.AuthorName</span>
                            </div>
                            <h3><a href="/Blog/BlogDetail/@blog.blogID">@blog.Title</a></h3>
                            <p class="blog-excerpt">@blog.Description</p>
                            <a href="/Blog/BlogDetail/@blog.blogID" class="btn-read-more">
                                Devamını Oku <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="text-center">
                <p class="text-muted mb-0">Henüz blog yazısı bulunmamaktadır.</p>
            </div>
        }
    </div>
</section>
